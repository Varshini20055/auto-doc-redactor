# Copy this file to .env and fill in real values before running.

ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./redactor.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://redactor_user:password@localhost:5432/redactor

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- PII Detection ---
SPACY_MODEL=en_core_web_lg
PRESIDIO_SCORE_THRESHOLD=0.35
PRESIDIO_REDACT_SCORE_THRESHOLD=0.30

# --- Compliance / hidden-data scrubbing ---
STRIP_METADATA=true
VERIFY_AFTER_REDACT=true
GENERATE_CERTIFICATE=true

# --- LLM (Grok/xAI — context-aware detection + chatbot) ---
LLM_ENABLED=true
LLM_PROVIDER=grok
GROK_API_KEY=<your-grok-api-key>   # from console.x.ai
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
# Min LLM confidence to auto-redact without Presidio agreement
LLM_CONFIDENCE_THRESHOLD=0.85

# --- OCR (for scanned/image-based PDFs) ---
OCR_ENGINE=paddleocr        # "paddleocr" | "tesseract"
OCR_FALLBACK=tesseract      # fallback if primary engine fails
# NOTE: Tesseract binary must be installed separately on the OS/container.
# Ubuntu/Debian: sudo apt-get install tesseract-ocr
# macOS:         brew install tesseract
# Windows:       https://github.com/UB-Mannheim/tesseract/wiki
# After install, set TESSDATA_PREFIX if needed, or ensure `tesseract` is on PATH.
